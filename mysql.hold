efault_config_hash\";s:43:\"8PRdPXuJiE_b1jhRFlE7kM0CefUym_9MMvH31NPP_eQ\";}s:2:\"id\";s:23:\"content_security_policy\";s:5:\"label\";s:23:\"Content-Security-Policy\";s:11:\"description\";s:227:\"This HTTP header parameter allows you to define a whitelist of approved sources of content for your site. By restricting the assets that a browser can load for your site you will have extra level of protection from XSS attacks.\";s:5:\"group\";s:8:\"Security\";s:4:\"name\";s:23:\"Content-Security-Policy\";s:5:\"value\";s:0:\"\";}'),('','http_response_headers.response_header.public_key_pins','a:11:{s:4:\"uuid\";s:36:\"50be0e67-e201-414b-8359-ad7f15a83be8\";s:8:\"langcode\";s:2:\"en\";s:6:\"status\";b:1;s:12:\"dependencies\";a:0:{}s:5:\"_core\";a:1:{s:19:\"default_config_hash\";s:43:\"y5y2OWGpErwqb5N0Lupj4IG-2IJdo2L3XtXBQXIxyag\";}s:2:\"id\";s:15:\"public_key_pins\";s:5:\"label\";s:15:\"Public-Key-Pins\";s:11:\"description\";s:221:\"HTTP Public Key Pinning (HPKP) is a security feature that tells a web client to associate a specific cryptographic public key with a certain web server to prevent Man in the Middle (MITM) attacks with forged certificates.\";s:5:\"group\";s:8:\"Security\";s:4:\"name\";s:15:\"Public-Key-Pins\";s:5:\"value\";s:0:\"\";}'),('','http_response_headers.response_header.referrer_policy','a:11:{s:4:\"uuid\";s:36:\"a7508ce4-40ad-4d63-8137-83670be47dcc\";s:8:\"langcode\";s:2:\"en\";s:6:\"status\";b:1;s:12:\"dependencies\";a:0:{}s:5:\"_core\";a:1:{s:19:\"default_config_hash\";s:43:\"Mh-mpEfEc0Zhqq_MC9BKCxsU5Ql4PsBwnCSaza77tRI\";}s:2:\"id\";s:15:\"referrer_policy\";s:5:\"label\";s:15:\"Referrer-Policy\";s:11:\"description\";s:173:\"Referrer Policy is a new header that allows a site to control how much information the browser includes with navigations away from a document and should be set by all sites.\";s:5:\"group\";s:8:\"Security\";s:4:\"name\";s:15:\"Referrer-Policy\";s:5:\"value\";s:31:\"strict-origin-when-cross-origin\";}'),('','http_response_headers.respon