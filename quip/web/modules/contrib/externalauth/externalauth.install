<?php

/**
 * @file
 * Install, update and uninstall functions for the externalauth module.
 */

use Drupal\Core\Database\Database;
use Drupal\Core\Database\SchemaObjectDoesNotExistException;
use Drupal\externalauth\ExternalAuthStorageLimits;

/**
 * Implements hook_install().
 */
function externalauth_install(): void {
  // Increase module weight to perform the authmap cleanup later.
  module_set_weight('externalauth', 10);
}

/**
 * Implements hook_schema().
 */
function externalauth_schema(): array {
  $schema['authmap'] = [
    'description' => 'Stores distributed authentication mapping.',
    'fields' => [
      'uid' => [
        'description' => 'Primary key: {users}.uid for user.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'provider' => [
        'description' => 'The name of the authentication provider providing the authname',
        'type' => 'varchar_ascii',
        'length' => ExternalAuthStorageLimits::AUTHMAP_PROVIDER_MAX_LENGTH,
        'not null' => TRUE,
        'default' => '',
        'binary' => TRUE,
      ],
      'authname' => [
        'description' => 'Unique authentication name provided by authentication provider',
        'type' => 'varchar',
        'length' => ExternalAuthStorageLimits::AUTHMAP_AUTHNAME_MAX_LENGTH,
        'not null' => TRUE,
        'default' => '',
        'binary' => TRUE,
      ],
      'data' => [
        'description' => 'Extra (serialized) data to store with the authname.',
        'type' => 'blob',
        'not null' => FALSE,
        'size' => 'big',
      ],
    ],
    'primary key' => ['uid', 'provider'],
    'indexes' => [
      'uid' => ['uid'],
    ],
    'unique keys' => [
      'authname_provider' => ['authname', 'provider'],
    ],
    'foreign keys' => [
      'uid' => ['users' => 'uid'],
    ],
  ];

  return $schema;
}

/**
 * Change {authmap}.authname type from varchar_ascii to varchar.
 */
function externalauth_update_8101(): void {
  $schema = Database::getConnection()->schema();
  if ($schema->tableExists('authmap')) {
    $schema->changeField('authmap', 'authname', 'authname', [
      'description' => 'Unique authentication name provided by authentication provider',
      'type' => 'varchar',
      'length' => 128,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
}

/**
 * Make index on authname+provider unique.
 */
function externalauth_update_8102(): void {
  /** @var \Drupal\Core\Database\Schema $schema */
  $schema = \Drupal::service('database')->schema();
  // This 'add' can potentially fail, if duplicate authnames are registered
  // already. This is why we do it before the 'remove'. If this happens, the
  // website maintainer is required to fix the table contents themselves.
  $schema->addUniqueKey('authmap', 'authname_provider', ['authname', 'provider']);
  $schema->dropIndex('authmap', 'auth_provider');
}

/**
 * Increase externalauth module weight.
 */
function externalauth_update_8103(): void {
  // Increase module weight to perform the authmap cleanup later.
  module_set_weight('externalauth', 10);
}

/**
 * Make authmap authname and provider columns binary-safe.
 *
 * Converts both columns from their previous case/accent-insensitive collations
 * to binary-safe equivalents so that byte-distinct authnames and provider
 * values are matched exactly by the database.
 *
 * NOTE: If your site has existing rows that differ only in case or accents for
 * the same provider (i.e. were inserted while a ci collation was active and the
 * unique key was not enforced), this update may fail. Resolve duplicate rows
 * manually before running this update.
 */
function externalauth_update_8104(): void {
  $schema = \Drupal::service('database')->schema();

  if (!$schema->tableExists('authmap')) {
    return;
  }

  // The unique key spans both columns being changed. Drop it first so that
  // the column-type changes cannot be blocked by index constraints on some
  // DB backends, then re-add it after both columns are updated.
  try {
    $schema->dropUniqueKey('authmap', 'authname_provider');
  }
  catch (SchemaObjectDoesNotExistException $e) {
    // Key did not exist; nothing to drop.
  }

  // Change authname to a binary-safe string column.
  $schema->changeField('authmap', 'authname', 'authname', [
    'description' => 'Unique authentication name provided by authentication provider',
    'type' => 'varchar',
    'length' => ExternalAuthStorageLimits::AUTHMAP_AUTHNAME_MAX_LENGTH,
    'not null' => TRUE,
    'default' => '',
    'binary' => TRUE,
  ]);

  // Change provider to a binary-safe string column so stored values are
  // matched exactly.
  $schema->changeField('authmap', 'provider', 'provider', [
    'description' => 'The name of the authentication provider providing the authname',
    'type' => 'varchar_ascii',
    'length' => ExternalAuthStorageLimits::AUTHMAP_PROVIDER_MAX_LENGTH,
    'not null' => TRUE,
    'default' => '',
    'binary' => TRUE,
  ]);

  // Re-add the unique key now that both columns are binary-safe. The key
  // itself is structurally identical; only the underlying column collation
  // has changed.
  $schema->addUniqueKey('authmap', 'authname_provider', ['authname', 'provider']);
}
