<?php

/**
 * @file
 * Hook implementations for the HTTP Response Headers module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\http_response_headers\Hook\HttpResponseHeadersHooks;
use Drupal\language\ConfigurableLanguageInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function http_response_headers_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(HttpResponseHeadersHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function http_response_headers_user_role_delete($role) {
  \Drupal::service(HttpResponseHeadersHooks::class)->userRoleDelete($role);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
#[LegacyHook]
function http_response_headers_configurable_language_delete(ConfigurableLanguageInterface $language) {
  \Drupal::service(HttpResponseHeadersHooks::class)->configurableLanguageDelete($language);
}
